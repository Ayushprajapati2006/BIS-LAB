import numpy as np
from sklearn.datasets import load_breast_cancer
from sklearn.model_selection import cross_val_score
from sklearn.ensemble import RandomForestClassifier

# 1. Load the Cancer Dataset
cancer_data = load_breast_cancer()
X = cancer_data.data               # Feature Matrix (569 rows x 30 columns)
y = cancer_data.target             # Binary Labels (0 = Malignant, 1 = Benign)
feature_names = cancer_data.feature_names
n_particles = 15
max_iter = 15
n_features = X.shape[1]

# BPSO Hyperparameters
w = 0.7        # Inertia weight
c1 = 1.5       # Cognitive weight
c2 = 1.5       # Social weight
alpha = 0.85   # Fitness weight (Higher alpha prioritizes accuracy over dropping features)

# Sigmoid function to map continuous velocities to bit probabilities [0, 1]
def sigmoid(v):
    return 1 / (1 + np.exp(-v))

# Fitness Function (Evaluates the quality of a chosen feature subset)
def compute_fitness(position):
    selected_indices = np.where(position == 1)[0]
    
    # Penalise completely empty feature selection masks
    if len(selected_indices) == 0:
        return 1.0 
    
    # Evaluate feature selection accuracy using 3-Fold Cross-Validation
    clf = RandomForestClassifier(n_estimators=50, random_state=42)
    scores = cross_val_score(clf, X[:, selected_indices], y, cv=3, scoring='accuracy', n_jobs=-1)
    accuracy = np.mean(scores)
    
    # Penalty calculation: Combine classification error and proportion of chosen features
    error_rate = 1.0 - accuracy
    feature_penalty = len(selected_indices) / n_features
    
    # Minimize fitness (0.0 is perfect)
    fitness = (alpha * error_rate) + ((1 - alpha) * feature_penalty)
    return fitness, accuracy

# 2. Initialization Space Setup
# Positions: binary array of shape (n_particles, n_features)
positions = np.random.randint(2, size=(n_particles, n_features))
# Velocities: continuous weights used to generate probabilities
velocities = np.random.uniform(-4, 4, size=(n_particles, n_features))

# Initialize arrays to store personal metrics
p_best_positions = np.copy(positions)
p_best_fitness = np.zeros(n_particles)
p_best_accuracy = np.zeros(n_particles)

for i in range(n_particles):
    p_best_fitness[i], p_best_accuracy[i] = compute_fitness(positions[i])

# Extract and track global best variables
g_best_index = np.argmin(p_best_fitness)
g_best_position = np.copy(p_best_positions[g_best_index])
g_best_fitness = p_best_fitness[g_best_index]
g_best_accuracy = p_best_accuracy[g_best_index]

# 3. Main Binary Particle Swarm Optimization Loop
print("Running BPSO Feature Selection Swarm Optimization Loop...\n")

for it in range(max_iter):
    for i in range(n_particles):
        r1 = np.random.rand(n_features)
        r2 = np.random.rand(n_features)
        
        # Continuous Velocity update equation
        velocities[i] = (w * velocities[i]) + \
                        (c1 * r1 * (p_best_positions[i] - positions[i])) + \
                        (c2 * r2 * (g_best_position - positions[i]))
        
        # Clamp velocity bounds to prevent sigmoid scaling saturation issues
        velocities[i] = np.clip(velocities[i], -6, 6)
        
        # Convert Continuous Velocities to Bit Probabilities via Sigmoid function
        bit_probabilities = sigmoid(velocities[i])
        
        # Update Binary Position Mask stochastically based on probabilities
        positions[i] = (np.random.rand(n_features) < bit_probabilities).astype(int)
        
        # Calculate fitness metric values for the new feature array
        current_fit, current_acc = compute_fitness(positions[i])
        
        # Track Personal Best Status updates
        if current_fit < p_best_fitness[i]:
            p_best_fitness[i] = current_fit
            p_best_accuracy[i] = current_acc
            p_best_positions[i] = np.copy(positions[i])
            
        # Track Global Best Status updates
        if current_fit < g_best_fitness:
            g_best_fitness = current_fit
            g_best_accuracy = current_acc
            g_best_position = np.copy(positions[i])
            
    print(f"Iteration {it+1:02d}/{max_iter:02d} -> Current Swarm Leader Accuracy: {g_best_accuracy * 100:.2f}%")

# 4. Final Validation & Evaluation Analysis Output Report
final_selected_indices = np.where(g_best_position == 1)[0]
selected_features = feature_names[final_selected_indices]

# Run baseline model evaluation comparison (using all features)
clf_baseline = RandomForestClassifier(n_estimators=100, random_state=42)
baseline_cv_scores = cross_val_score(clf_baseline, X, y, cv=5)
pso_cv_scores = cross_val_score(clf_baseline, X[:, final_selected_indices], y, cv=5)

print("\n" + "="*60)
print("              BPSO FINAL REPORT CARD RESULTS                 ")
print("="*60)
print(f"Total Features Available:            {n_features}")
print(f"BPSO Selected Features Count:        {len(final_selected_indices)}")
print(f"Baseline Accuracy (All Features):    {np.mean(baseline_cv_scores) * 100:.2f}%")
print(f"Optimized Accuracy (BPSO Subset):    {np.mean(pso_cv_scores) * 100:.2f}%")
print("-"*60)
print("List of Optimally Chosen Features by the Swarm:")
for idx, name in enumerate(selected_features, 1):
    print(f" {idx:02d}. {name}")
print("="*60)
